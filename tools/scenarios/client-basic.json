{
  "name": "客户端操控基础",
  "timeout": 20,
  "steps": [
    {
      "cli": "ping",
      "expect": [
        {
          "path": "ok",
          "eq": true
        }
      ]
    },
    {
      "wait": {
        "cli": "state",
        "timeout": 120000,
        "interval": 1500,
        "expect": [
          {
            "path": "result.detail",
            "contains": "name="
          }
        ]
      },
      "note": "等客户端进服完成（未进服时 state 回 NOT_IN_GAME）"
    },
    {
      "cli": "keys",
      "expect": [
        {
          "path": "result.detail",
          "contains": "forward="
        }
      ]
    },
    {
      "cli": "inv",
      "expect": [
        {
          "path": "ok",
          "eq": true
        }
      ]
    },
    {
      "cli": "look",
      "args": {
        "yaw": 90,
        "pitch": 5
      },
      "expect": [
        {
          "path": "ok",
          "eq": true
        }
      ]
    },
    {
      "cli": "scan",
      "args": {
        "radius": 4
      },
      "expect": [
        {
          "path": "ok",
          "eq": true
        }
      ]
    },
    {
      "cli": "events",
      "expect": [
        {
          "path": "ok",
          "eq": true
        }
      ]
    },
    {
      "cli": "shot",
      "args": {
        "name": "scenario-check"
      },
      "expect": [
        {
          "path": "ok",
          "eq": true
        }
      ]
    }
  ]
}
